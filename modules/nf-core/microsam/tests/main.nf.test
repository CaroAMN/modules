// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test microsam
nextflow_process {

    name "Test Process MICROSAM"
    script "../main.nf"
    process "MICROSAM"

    tag "modules"
    tag "modules_nfcore"
    tag "microsam"

    test("segmentation nuclear - tif") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'molkart/test_data/input_data/nuclear.tiff', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("segmentation nuclear - tif - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'molkart/test_data/input_data/nuclear.tiff', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
