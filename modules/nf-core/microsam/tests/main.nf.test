
nextflow_process {

    name "Test Process MICROSAM"
    script "../main.nf"
    process "MICROSAM"
    config "./microsam-test.config"

    tag "modules"
    tag "modules_nfcore"
    tag "microsam"
  
    test("segmentation nuclear - tif") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/molkart/test_data/input_data/nuclear.tiff', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("segmentation nuclear - tif - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/molkart/test_data/input_data/nuclear.tiff', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
